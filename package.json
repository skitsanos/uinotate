{
  "name": "uinotate",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone feedback and DOM annotation widget with element screenshots.",
  "scripts": {
    "dev": "bun examples/server.js",
    "dev:netlify": "bun run build:site && bun scripts/dev-netlify.js",
    "build": "bun scripts/build.js",
    "build:site": "bun run build && bun scripts/build-site.js",
    "netlify:secret": "bun scripts/setup-netlify-secret.js",
    "smoke:site": "bun scripts/smoke-site.js",
    "test": "bun run build && bun test",
    "check": "bun scripts/check.js"
  },
  "devDependencies": {
    "happy-dom": "^21.0.1",
    "html-to-image": "1.11.13"
  }
}
